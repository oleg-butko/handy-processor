{
  "name": "handy-processor-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Optional Tauri desktop shell for Handy Processor",
  "scripts": {
    "tauri": "tauri",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --lib -- -D warnings",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "build:portable": "tauri build --no-bundle",
    "build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.4"
  }
}
