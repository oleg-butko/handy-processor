{
  "name": "handy-processor",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny OpenAI-compatible post-processing server for Handy transcriptions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:numerals": "python3 scripts/generate_russian_numerals.py",
    "check:numerals": "python3 scripts/generate_russian_numerals.py --check",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
